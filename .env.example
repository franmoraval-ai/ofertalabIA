# OfertaLab IA Clientes — variables de entorno (plantilla)
# Copia este archivo a ".env.local" y rellena con tus valores reales de Supabase.
# NUNCA subas .env.local ni pegues estos secretos en un chat.

# Connection string de Postgres de Supabase.
# Usa el POOLER en modo transacción (host con "pooler.supabase.com", puerto 6543).
# Panel Supabase: Project Settings > Database > Connection string > Transaction pooler.
DATABASE_URL="postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Token compartido entre OfertaLab IA Operaciones (escritorio) y el portal.
# Debe coincidir con el sync_token del escritorio. Genera uno largo y aleatorio.
OFERTALAB_SYNC_TOKEN="genera-un-token-largo-y-aleatorio"

# Supabase Auth (frontend). Estas dos NO son secretas (van al navegador).
NEXT_PUBLIC_SUPABASE_URL="https://TU_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="TU_ANON_KEY"
